{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ProgressPhase": {
      "description": "进度阶段。",
      "oneOf": [
        {
          "description": "加载配置或插件。",
          "enum": [
            "load"
          ],
          "type": "string"
        },
        {
          "description": "扫描资源。",
          "enum": [
            "scan"
          ],
          "type": "string"
        },
        {
          "description": "计量容量。",
          "enum": [
            "measure"
          ],
          "type": "string"
        },
        {
          "description": "生成计划。",
          "enum": [
            "plan"
          ],
          "type": "string"
        },
        {
          "description": "A system command is requesting authorization or running with elevated access.",
          "enum": [
            "authorize"
          ],
          "type": "string"
        },
        {
          "description": "执行清理。",
          "enum": [
            "clean"
          ],
          "type": "string"
        },
        {
          "description": "当前阶段完成。",
          "enum": [
            "complete"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "扫描和清理进度事件。",
  "properties": {
    "current": {
      "description": "Current count reported by this step; `None` when unknown.",
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "handler_id": {
      "description": "可选 Handler ID。",
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "description": "英文进度说明。",
      "type": "string"
    },
    "module_id": {
      "description": "可选模块 ID。",
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "allOf": [
        {
          "$ref": "#/definitions/ProgressPhase"
        }
      ],
      "description": "当前阶段。"
    },
    "task_id": {
      "description": "可选任务 ID。",
      "type": [
        "string",
        "null"
      ]
    },
    "total": {
      "description": "总量；未知时为 `None`。",
      "format": "uint",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "message",
    "phase"
  ],
  "title": "ProgressEvent",
  "type": "object"
}
