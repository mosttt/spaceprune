{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AutomationDefinition": {
      "additionalProperties": false,
      "description": "一个配置化自动化任务。",
      "properties": {
        "at": {
          "allOf": [
            {
              "$ref": "#/definitions/DailyTime"
            }
          ],
          "default": "03:00",
          "description": "每日执行的本地时间。"
        },
        "enabled": {
          "default": true,
          "description": "是否启用。",
          "type": "boolean"
        },
        "modules": {
          "default": [],
          "description": "要扫描的模块；空数组表示全部模块。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "显示名称。",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "DailyTime": {
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "type": "string"
    },
    "IncludeReference": {
      "anyOf": [
        {
          "description": "An unconditional source include.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A platform-dependent include, skipped before any path access when inactive.",
          "properties": {
            "path": {
              "description": "Source reference.",
              "type": "string"
            },
            "platforms": {
              "default": [],
              "description": "Empty means all platforms.",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      ],
      "description": "Source include syntax shared by schemas and configuration consumers."
    },
    "ModuleDefinition": {
      "additionalProperties": false,
      "description": "一个配置化模块。",
      "properties": {
        "description": {
          "default": "",
          "description": "模块说明。",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "是否启用。",
          "type": "boolean"
        },
        "name": {
          "description": "显示名称。",
          "type": "string"
        },
        "order": {
          "default": 0,
          "description": "显示顺序。",
          "format": "int32",
          "type": "integer"
        },
        "selectors": {
          "additionalProperties": {
            "$ref": "#/definitions/SelectorDefinition"
          },
          "default": {},
          "description": "配置化布尔选择器。",
          "type": "object"
        },
        "tasks": {
          "additionalProperties": {
            "$ref": "#/definitions/TaskDefinition"
          },
          "default": {},
          "description": "模块任务。",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "RecipeUsage": {
      "description": "Whether a recipe is a recurring rule or an explicit single-use selection.",
      "oneOf": [
        {
          "description": "Re-enumerate the declared scope on every scan; eligible for scheduled cleanup.",
          "enum": [
            "recurring"
          ],
          "type": "string"
        },
        {
          "description": "Keep exact observed bindings; never eligible for recurring automation.",
          "enum": [
            "one_shot"
          ],
          "type": "string"
        }
      ]
    },
    "Requirements": {
      "additionalProperties": false,
      "description": "清理方案依赖。",
      "properties": {
        "plugins": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "插件 ID 到版本要求的映射。",
          "type": "object"
        }
      },
      "type": "object"
    },
    "SelectorDefinition": {
      "additionalProperties": false,
      "description": "模块的命令行选择器。",
      "properties": {
        "enabled": {
          "default": true,
          "description": "是否启用选择器。",
          "type": "boolean"
        },
        "match-tags": {
          "default": [],
          "description": "任务必须包含的全部标签。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "选择器显示名称。",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "TaskDefinition": {
      "additionalProperties": false,
      "description": "一个 Handler 任务。",
      "properties": {
        "description": {
          "default": "",
          "description": "任务说明。",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "是否启用。",
          "type": "boolean"
        },
        "handler": {
          "description": "完整 Handler ID。",
          "type": "string"
        },
        "name": {
          "description": "任务显示名称。",
          "type": "string"
        },
        "options": {
          "additionalProperties": true,
          "default": {},
          "description": "Handler 扫描和清理选项。",
          "type": "object"
        },
        "order": {
          "default": 0,
          "description": "模块内显示顺序。",
          "format": "int32",
          "type": "integer"
        },
        "platforms": {
          "default": [],
          "description": "允许执行该任务的平台；空数组表示不额外限制。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "recommend": {
          "additionalProperties": true,
          "default": {},
          "description": "Handler 推荐规则。",
          "type": "object"
        },
        "tags": {
          "default": [],
          "description": "用于选择器过滤的标签。",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "handler",
        "name"
      ],
      "type": "object"
    }
  },
  "description": "An unresolved, complete recipe declaration. Loading includes and expanding paths are host work.",
  "properties": {
    "automations": {
      "additionalProperties": {
        "$ref": "#/definitions/AutomationDefinition"
      },
      "default": {},
      "description": "User-configured recurring automation.",
      "type": "object"
    },
    "include": {
      "default": [],
      "description": "Includes remain source declarations; inactive platforms are not read by the resolver.",
      "items": {
        "$ref": "#/definitions/IncludeReference"
      },
      "type": "array"
    },
    "modules": {
      "additionalProperties": {
        "$ref": "#/definitions/ModuleDefinition"
      },
      "default": {},
      "description": "Original modules, selectors and tasks; no flattening into a device-only rule list.",
      "type": "object"
    },
    "name": {
      "description": "Human-readable recipe name.",
      "type": "string"
    },
    "requires": {
      "allOf": [
        {
          "$ref": "#/definitions/Requirements"
        }
      ],
      "default": {
        "plugins": {}
      },
      "description": "Required handler providers and versions."
    },
    "schema-version": {
      "const": 2,
      "description": "Public persistent schema version, distinct from any tool or provider protocol.",
      "type": "integer"
    },
    "usage": {
      "allOf": [
        {
          "$ref": "#/definitions/RecipeUsage"
        }
      ],
      "default": "recurring",
      "description": "Recurring rule or explicit single-use selection."
    },
    "variable-map": {
      "default": null,
      "description": "Source variable map, before platform and user expansion.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "schema-version"
  ],
  "title": "RecipeDefinition",
  "type": "object"
}
